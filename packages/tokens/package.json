{
  "name": "@atelier/tokens",
  "version": "0.1.0",
  "private": true,
  "description": "Design tokens: single source of truth for color, type, space, motion. Codegens CSS vars, TS types, and Tailwind v4 @theme blocks.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": { "types": "./src/index.ts", "import": "./src/index.ts" },
    "./schema": "./src/brief.schema.ts",
    "./codegen": "./src/codegen.ts"
  },
  "scripts": { "build": "tsc -p tsconfig.json", "typecheck": "tsc --noEmit" },
  "dependencies": { "culori": "^4.0.1", "zod": "^3.23.8" },
  "devDependencies": { "typescript": "^5.6.3", "@types/culori": "^2.1.1" }
}
