# =====================================================
# Telegram Job Repost Bot - Environment Variables
# =====================================================
# Copy this file to .env and fill in your values

# =====================================================
# Telegram API Credentials
# Get from https://my.telegram.org/apps
# =====================================================
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash

# Phone number for user account (format: +79001234567)
TELEGRAM_PHONE=+79001234567

# Bot token (for publishing via Bot API)
# Get from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token

# =====================================================
# Supabase Configuration
# =====================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_KEY=your_service_role_key

# =====================================================
# AI Parser Configuration
# =====================================================
# OpenAI (optional - for AI parsing)
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4-turbo-preview

# Anthropic Claude (optional - alternative AI parser)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# Which AI to use: openai, anthropic, or none
AI_PROVIDER=openai

# =====================================================
# n8n Integration
# =====================================================
N8N_WEBHOOK_URL=https://your-n8n.app.n8n.cloud/webhook/job-bot
N8N_API_KEY=your_n8n_api_key

# =====================================================
# Webhook Server (for n8n callbacks)
# =====================================================
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
WEBHOOK_SECRET=your_random_secret_key

# =====================================================
# Bot Settings
# =====================================================
# Check interval in minutes
CHECK_INTERVAL_MINUTES=60

# Maximum posts per hour
MAX_POSTS_PER_HOUR=24

# Target group/channel ID (negative for groups/channels)
TARGET_GROUP_ID=-1001234567890
TARGET_CHANNEL_ID=-1001234567891

# =====================================================
# Parser Settings
# =====================================================
# Enable/disable parsers
REGEX_PARSER_ENABLED=true
AI_PARSER_ENABLED=true

# Fallback: use regex if AI fails
AI_FALLBACK_TO_REGEX=true

# =====================================================
# Logging
# =====================================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# =====================================================
# Session Storage
# =====================================================
# Path to store Pyrogram session file
SESSION_PATH=./sessions
SESSION_NAME=job_repost_bot

# =====================================================
# Rate Limiting
# =====================================================
# Delay between API calls (seconds)
API_DELAY_SECONDS=2

# Delay between posts (seconds)
POST_DELAY_SECONDS=150

# =====================================================
# Retry Settings
# =====================================================
MAX_RETRIES=3
RETRY_DELAY_SECONDS=5
