{
  "name": "HR Bot - Admin Notifications",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Every 5 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM admin_notifications \nWHERE is_sent = false \nORDER BY \n  CASE level \n    WHEN 'critical' THEN 1 \n    WHEN 'error' THEN 2 \n    WHEN 'warning' THEN 3 \n    ELSE 4 \n  END,\n  created_at ASC\nLIMIT 10"
      },
      "id": "get-pending",
      "name": "Get Pending Notifications",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [220, 300],
      "credentials": {
        "supabaseApi": {
          "id": "4",
          "name": "HR Bot Supabase"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-notifications",
              "leftValue": "={{ $input.all().length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if-has-notifications",
      "name": "Has Notifications?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "jsCode": "// Format notification messages\nconst notifications = $input.all();\n\nconst levelEmoji = {\n  'info': 'ℹ️',\n  'warning': '⚠️',\n  'error': '❌',\n  'critical': '🚨'\n};\n\nreturn notifications.map(n => {\n  const item = n.json;\n  const emoji = levelEmoji[item.level] || 'ℹ️';\n\n  let message = `${emoji} *${item.title}*\\n\\n`;\n  message += item.message;\n\n  if (item.source) {\n    message += `\\n\\n_Источник: ${item.source}_`;\n  }\n\n  const createdAt = new Date(item.created_at);\n  message += `\\n_${createdAt.toLocaleString('ru-RU')}_`;\n\n  return {\n    json: {\n      id: item.id,\n      message,\n      level: item.level\n    }\n  };\n});"
      },
      "id": "format-messages",
      "name": "Format Messages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 300]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_ADMIN_CHAT_ID }}",
        "text": "={{ $json.message }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "send-notification",
      "name": "Send to Admin",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [880, 300],
      "credentials": {
        "telegramApi": {
          "id": "1",
          "name": "HR Bot Telegram"
        }
      }
    },
    {
      "parameters": {
        "operation": "update",
        "tableId": "admin_notifications",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "keyValue": "={{ $json.id }}"
            }
          ]
        },
        "fieldsToSend": {
          "values": [
            {
              "fieldId": "is_sent",
              "fieldValue": "true"
            },
            {
              "fieldId": "sent_at",
              "fieldValue": "={{ new Date().toISOString() }}"
            }
          ]
        }
      },
      "id": "mark-sent",
      "name": "Mark as Sent",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1100, 300],
      "credentials": {
        "supabaseApi": {
          "id": "4",
          "name": "HR Bot Supabase"
        }
      }
    },
    {
      "parameters": {},
      "id": "no-op",
      "name": "No Notifications",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [660, 500]
    }
  ],
  "connections": {
    "Every 5 Minutes": {
      "main": [
        [
          {
            "node": "Get Pending Notifications",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Pending Notifications": {
      "main": [
        [
          {
            "node": "Has Notifications?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Notifications?": {
      "main": [
        [
          {
            "node": "Format Messages",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "No Notifications",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Messages": {
      "main": [
        [
          {
            "node": "Send to Admin",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send to Admin": {
      "main": [
        [
          {
            "node": "Mark as Sent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [
    {
      "name": "HR Bot"
    }
  ],
  "triggerCount": 1,
  "active": false
}
