{
  "name": "HR Bot - 03 Router",
  "nodes": [
    {
      "parameters": {},
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [0, 0],
      "id": "workflow-trigger",
      "name": "Execute Workflow Trigger"
    },
    {
      "parameters": {
        "jsCode": "// ============================================================\n// ROUTER v4.0: Regex Pre-Routing (экономит ~40% API вызовов)\n// ============================================================\n\nconst context = $json;\nconst text = (context.user_message || '').toLowerCase().trim();\nconst callback = context.callback_data || '';\n\n// REGEX RULES (НЕ требуют LLM)\nlet fastRoute = null;\n\n// 1. Callback выбора языка\nif (callback.startsWith('lang_')) {\n  fastRoute = 'LANGUAGE';\n}\n// 2. Команда /start (новый пользователь)\nelse if (text === '/start' || text === 'start') {\n  fastRoute = context.is_new_user ? 'GREETING' : 'INTERVIEW';\n}\n// 3. Команда /cancel или /restart - сброс анкеты\nelse if (text === '/cancel' || text === '/restart' || text === 'отмена' || text === 'заново') {\n  fastRoute = 'CANCEL';\n}\n// 4. Команда /help - эскалация\nelse if (text === '/help' || text === 'помощь' || text === 'помоги') {\n  fastRoute = 'ESCALATION';\n}\n// 5. Явный выбор языка (без истории)\nelse if (!context.chat_history?.length && \n         (text.includes('русский') || text.includes('кыргыз') || \n          text.includes('узбек') || text.includes('тоҷик'))) {\n  fastRoute = 'LANGUAGE';\n}\n// 6. Простые приветствия (новый пользователь)\nelse if (context.is_new_user && !context.chat_history?.length &&\n         /^(привет|здравствуй|салам|hi|hello|хай|ассалом)/.test(text)) {\n  fastRoute = 'GREETING';\n}\n\nreturn {\n  ...context,\n  fast_route: fastRoute,\n  needs_llm: fastRoute === null\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0],
      "id": "regex-pre-router",
      "name": "Regex Pre-Router"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 1
          },
          "conditions": [
            {
              "leftValue": "={{ $json.needs_llm }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              },
              "id": "needs-llm-check"
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [440, 0],
      "id": "if-needs-llm",
      "name": "IF Needs LLM"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Сообщение пользователя: {{ $json.user_message }}\n\nЭто новый пользователь: {{ $json.is_new_user }}\nТекущий язык: {{ $json.language }}\n\nИСТОРИЯ ДИАЛОГА:\n{{ $json.chat_history_text }}\n\nИЗВЕСТНЫЕ ДАННЫЕ О КАНДИДАТЕ:\n{{ JSON.stringify($json.known_data) }}",
        "options": {
          "systemMessage": "Ты — классификатор сообщений для HR-бота. Определи категорию.\n\nКАТЕГОРИИ:\n- INTERVIEW: ответы на вопросы анкеты (имя, возраст, опыт, документы, телефон)\n- FAQ: вопросы о вакансии (зарплата, график, условия, где работать)\n- ESCALATION: просьба о помощи человека (менеджер, не понимаю)\n\nПРАВИЛА:\n1. Вопрос о зарплате/графике/условиях → FAQ\n2. Просит менеджера/помощь → ESCALATION\n3. Всё остальное → INTERVIEW\n\nОтвечай ТОЛЬКО JSON: {\"category\": \"INTERVIEW\", \"confidence\": 0.95}",
          "timeout": 10000
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [660, -100],
      "id": "router-agent",
      "name": "Router Agent (LLM)",
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1000
    },
    {
      "parameters": {
        "options": {
          "maxTokens": 100,
          "temperature": 0.1,
          "timeout": 10000
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatDeepSeek",
      "typeVersion": 1,
      "position": [660, 100],
      "id": "deepseek-router",
      "name": "DeepSeek Router",
      "credentials": {
        "deepSeekApi": {
          "id": "g1KQFdKf5EC4OIiO",
          "name": "DeepSeek account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// ============================================================\n// Parse LLM Response (v4.0)\n// ============================================================\n\nconst routerResponse = $json.text || $json.output || $json.content || '{}';\nconst context = $('Regex Pre-Router').first().json;\n\nlet parsed = { category: 'INTERVIEW', confidence: 0.5 };\n\ntry {\n  const cleanJson = String(routerResponse)\n    .replace(/```json\\n?/g, '')\n    .replace(/```\\n?/g, '')\n    .trim();\n  const jsonMatch = cleanJson.match(/\\{[\\s\\S]*?\\}/);\n  if (jsonMatch) {\n    parsed = { ...parsed, ...JSON.parse(jsonMatch[0]) };\n  }\n} catch (e) {\n  console.log('Router parse error, defaulting to INTERVIEW:', e.message);\n}\n\n// Override rules\nif (context.chat_history?.length > 0 && parsed.category === 'GREETING') {\n  parsed.category = 'INTERVIEW';\n}\n\nif (context.known_data?.first_name && \n    parsed.category !== 'FAQ' && \n    parsed.category !== 'ESCALATION') {\n  parsed.category = 'INTERVIEW';\n}\n\nreturn {\n  ...context,\n  route_category: parsed.category,\n  route_confidence: parsed.confidence || 0.8\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, -150],
      "id": "parse-llm-response",
      "name": "Parse LLM Response"
    },
    {
      "parameters": {
        "jsCode": "// LLM Error Fallback - default to INTERVIEW\nconst context = $('Regex Pre-Router').first().json;\n\nconsole.log('⚠️ ROUTER: LLM failed, defaulting to INTERVIEW');\n\nreturn {\n  ...context,\n  route_category: 'INTERVIEW',\n  route_confidence: 0.5,\n  llm_failed: true\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 0],
      "id": "llm-error-fallback",
      "name": "LLM Error Fallback"
    },
    {
      "parameters": {
        "jsCode": "// Fast Route - уже определено regex\nconst context = $json;\n\nreturn {\n  ...context,\n  route_category: context.fast_route,\n  route_confidence: 1.0\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 150],
      "id": "fast-route-result",
      "name": "Fast Route Result"
    },
