                "conditions": [{"leftValue": "={{ $json.route_category }}", "rightValue": "INTERVIEW", "operator": {"type": "string", "operation": "equals"}, "id": "interview-check"}],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Interview"
            },
            {
              "conditions": {
                "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 3},
                "conditions": [{"leftValue": "={{ $json.route_category }}", "rightValue": "FAQ", "operator": {"type": "string", "operation": "equals"}, "id": "faq-check"}],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "FAQ"
            },
            {
              "conditions": {
                "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 3},
                "conditions": [{"leftValue": "={{ $json.route_category }}", "rightValue": "ESCALATION", "operator": {"type": "string", "operation": "equals"}, "id": "escalation-check"}],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Escalation"
            },
            {
              "conditions": {
                "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 3},
                "conditions": [{"leftValue": "={{ $json.route_category }}", "rightValue": "LANGUAGE", "operator": {"type": "string", "operation": "equals"}, "id": "language-check"}],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Language"
            },
            {
              "conditions": {
                "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 3},
                "conditions": [{"leftValue": "={{ $json.route_category }}", "rightValue": "CANCEL", "operator": {"type": "string", "operation": "equals"}, "id": "cancel-check"}],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Cancel"
            }
          ]
        },
        "options": {"fallbackOutput": "extra"}
      },
