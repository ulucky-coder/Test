      "parameters": {
        "jsCode": "// ============================================================\n// CANCEL HANDLER: Сброс анкеты\n// ============================================================\n\nconst context = $json;\n\nreturn {\n  ...context,\n  response_message: '🔄 Хорошо! Анкета сброшена.\\n\\nДавайте начнём заново. Выберите язык общения:',\n  final_message: '🔄 Хорошо! Анкета сброшена.\\n\\nДавайте начнём заново. Выберите язык общения:',\n  show_language_buttons: true,\n  extracted_data: {},\n  interview_complete: false,\n  needs_escalation: false,\n  reset_session: true\n};"
