      "parameters": {
        "jsCode": "// Check Redis State - проверяем есть ли активный диалог\nconst message = $input.item.json.message;\nconst chatId = message.chat.id;\nconst userId = message.from.id;\n\n// Ключ для Redis\nconst stateKey = `hr_bot:state:${chatId}:${userId}`;\n\nreturn {\n  json: {\n    message,\n    stateKey,\n    chatId,\n    userId\n  }\n};"
      },
      "id": "prepare-redis-key",
      "name": "Prepare Redis Key",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 500]
    },
    {
      "parameters": {
        "operation": "get",
        "key": "={{ $json.stateKey }}"
      },
      "id": "redis-get-state",
      "name": "Redis Get State",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [880, 500],
      "credentials": {
        "redis": {
          "id": "2",
          "name": "HR Bot Redis"
        }
      }
