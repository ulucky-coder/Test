    {
      "parameters": {
        "jsCode": "// Process LLM Classification result\nconst input = $input.item.json;\nconst llmResponse = input.choices?.[0]?.message?.content?.toLowerCase() || 'chat';\nconst originalData = $('Classify Message').item.json;\n\nlet messageType = 'chat';\nif (llmResponse.includes('candidate')) {\n  messageType = 'candidate';\n} else if (llmResponse.includes('payment')) {\n  messageType = 'payment';\n}\n\nreturn {\n  json: {\n    message: originalData.message,\n    classification: {\n      ...originalData.classification,\n      type: messageType,\n      llmClassification: llmResponse\n    }\n  }\n};"
      },
