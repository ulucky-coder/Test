        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"deepseek-chat\",\n  \"temperature\": 0.1,\n  \"max_tokens\": 100,\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Определи тип сообщения. Варианты: candidate (данные о кандидате), payment (данные об оплате), chat (обычный разговор). Отвечай одним словом.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": {{ JSON.stringify($json.message.text) }}\n    }\n  ]\n}",
        "options": {}
      },
      "id": "llm-classify",
      "name": "LLM Classify",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1540, 900],
      "credentials": {
        "httpHeaderAuth": {
          "id": "3",
          "name": "DeepSeek API"
        }
