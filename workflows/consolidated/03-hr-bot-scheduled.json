    {
      "parameters": {
        "jsCode": "// Aggregate maintenance results\nconst llmCache = $('Cleanup LLM Cache').all().length;\nconst logs = $('Cleanup Logs').all().length;\nconst audit = $('Cleanup Audit').all().length;\nconst linked = $('Link Payments').item?.json?.linked || 0;\n\nconst totalCleaned = llmCache + logs + audit;\nconst significant = totalCleaned > 100 || linked > 10;\n\nreturn {\n  json: {\n    llmCache,\n    logs,\n    audit,\n    linked,\n    totalCleaned,\n    significant,\n    timestamp: new Date().toISOString()\n  }\n};"
      },
      "id": "aggregate-maintenance",
      "name": "Aggregate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 800]
    },
