    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n  status,\n  COUNT(*) as count,\n  ROUND(COUNT(*) * 100.0 / SUM(COUNT(*)) OVER(), 1) as percentage\nFROM candidates \nWHERE created_at::date = CURRENT_DATE\nGROUP BY status\nORDER BY count DESC"
      },
      "id": "supabase-daily-stats",
      "name": "Get Daily Stats",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [220, 200],
      "credentials": {
        "supabaseApi": {
          "id": "4",
          "name": "HR Bot Supabase"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n  telegram_username,\n  COUNT(*) as added_today\nFROM candidates \nWHERE created_at::date = CURRENT_DATE\nGROUP BY telegram_username\nORDER BY added_today DESC\nLIMIT 10"
      },
      "id": "supabase-daily-recruiters",
      "name": "Get Recruiters",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [220, 100],
      "credentials": {
        "supabaseApi": {
          "id": "4",
          "name": "HR Bot Supabase"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Build daily report\nconst stats = $('Get Daily Stats').all().map(i => i.json).filter(s => s.status);\nconst recruiters = $('Get Recruiters').all().map(i => i.json).filter(r => r.telegram_username);\n\nconst today = new Date().toLocaleDateString('ru-RU', { weekday: 'long', day: 'numeric', month: 'long' });\nconst total = stats.reduce((s, r) => s + parseInt(r.count || 0), 0);\n\nlet text = `📊 *Ежедневный отчёт*\\n📅 ${today}\\n\\n`;\n\nif (total === 0) {\n  text += '_Сегодня кандидатов не добавлено._';\n} else {\n  text += `👥 *Всего за день:* ${total}\\n\\n`;\n  \n  const emoji = { 'направлен': '📋', 'собеседование': '🗣', 'оформление': '📝', 'работает': '✅', 'отказ': '❌', 'архив': '📦' };\n  \n  text += '*По статусам:*\\n';\n  stats.forEach(s => {\n    text += `${emoji[s.status] || '•'} ${s.status}: ${s.count} (${s.percentage}%)\\n`;\n  });\n  \n  if (recruiters.length > 0) {\n    text += '\\n*Топ рекрутеров:*\\n';\n    recruiters.slice(0, 5).forEach((r, i) => {\n      const medal = i === 0 ? '🥇' : i === 1 ? '🥈' : i === 2 ? '🥉' : `${i+1}.`;\n      text += `${medal} @${r.telegram_username}: ${r.added_today}\\n`;\n    });\n  }\n}\n\nreturn { json: { text, hasData: total > 0 } };"
      },
      "id": "build-daily-report",
      "name": "Build Daily Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 200]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_CANDIDATES }}",
        "text": "={{ $json.text }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "telegram-daily-report",
      "name": "Send Daily Report",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [660, 200],
      "credentials": {
        "telegramApi": {
          "id": "1",
          "name": "HR Bot Telegram"
        }
      }
    },
    {
      "parameters": {
        "operation": "insert",
        "tableId": "bot_logs",
        "fieldsToSend": {
          "values": [
            { "fieldId": "level", "fieldValue": "info" },
            { "fieldId": "source", "fieldValue": "daily-report" },
            { "fieldId": "message", "fieldValue": "Daily report sent" },
            { "fieldId": "context", "fieldValue": "={{ JSON.stringify({ hasData: $json.hasData }) }}" }
          ]
        }
      },
      "id": "log-daily-report",
      "name": "Log Daily",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [880, 200],
      "credentials": {
        "supabaseApi": {
          "id": "4",
          "name": "HR Bot Supabase"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, title, message, level, source, created_at \nFROM admin_notifications \nWHERE is_sent = false \nORDER BY \n  CASE level \n    WHEN 'critical' THEN 1 \n    WHEN 'error' THEN 2 \n    WHEN 'warning' THEN 3 \n    ELSE 4 \n  END,\n  created_at ASC\nLIMIT 10"
      },
      "id": "supabase-get-notifications",
      "name": "Get Notifications",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [220, 500],
      "credentials": {
        "supabaseApi": {
          "id": "4",
          "name": "HR Bot Supabase"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [{ "leftValue": "={{ $json.id }}", "rightValue": "", "operator": { "type": "number", "operation": "exists" } }],
          "combinator": "and"
        }
      },
      "id": "if-has-notifications",
      "name": "Has Notifications?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [440, 500]
    },
    {
      "parameters": {
        "jsCode": "// Format notification\nconst n = $input.item.json;\n\nconst emoji = { 'info': 'ℹ️', 'warning': '⚠️', 'error': '❌', 'critical': '🚨' };\nconst text = `${emoji[n.level] || 'ℹ️'} *${n.title}*\\n\\n${n.message}\\n\\n_${n.source} • ${new Date(n.created_at).toLocaleString('ru-RU')}_`;\n\nreturn { json: { id: n.id, text } };"
      },
      "id": "format-notification",
      "name": "Format",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 400]
    },
