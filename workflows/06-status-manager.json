      "parameters": {
        "jsCode": "// Candidate not found\nconst parseData = $('Parse Input').item.json;\n\nreturn {\n  json: {\n    message: `❌ Кандидат \"${parseData.candidateSearch}\" не найден за последние 30 дней.`,\n    chatId: parseData.chatId\n  }\n};"
      },
