    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=SELECT * FROM candidates \nWHERE \n  (phone LIKE '%{{ $json.candidateSearch }}%' \n   OR full_name ILIKE '%{{ $json.candidateSearch }}%')\n  AND created_at >= NOW() - INTERVAL '30 days'\nORDER BY created_at DESC\nLIMIT 1"
      },
