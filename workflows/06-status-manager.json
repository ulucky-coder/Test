    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=SELECT * FROM candidates WHERE id = '{{ $json.candidateId }}'"
      },
      "id": "get-candidate-by-id",
      "name": "Get Candidate by ID",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [880, 100],
      "credentials": {
        "supabaseApi": {
          "id": "4",
          "name": "HR Bot Supabase"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Build status buttons\nconst input = $input.item.json;\nconst candidate = input;\nconst parseData = $('Parse Input').item.json;\n\nconst statuses = [\n  { label: '📋 Направлен', value: 'направлен' },\n  { label: '🗣 Собеседование', value: 'собеседование' },\n  { label: '📝 Оформление', value: 'оформление' },\n  { label: '✅ Работает', value: 'работает' },\n  { label: '❌ Отказ', value: 'отказ' },\n  { label: '📦 Архив', value: 'архив' }\n];\n\n// Убираем текущий статус из кнопок\nconst availableStatuses = statuses.filter(s => s.value !== candidate.status);\n\nconst keyboard = {\n  inline_keyboard: [\n    availableStatuses.slice(0, 2).map(s => ({\n      text: s.label,\n      callback_data: `status_${s.value}_${candidate.id}`\n    })),\n    availableStatuses.slice(2, 4).map(s => ({\n      text: s.label,\n      callback_data: `status_${s.value}_${candidate.id}`\n    })),\n    availableStatuses.slice(4, 6).map(s => ({\n      text: s.label,\n      callback_data: `status_${s.value}_${candidate.id}`\n    })),\n    [{ text: '❌ Отмена', callback_data: 'status_cancel' }]\n  ].filter(row => row.length > 0)\n};\n\nconst statusEmoji = {\n  'направлен': '📋',\n  'собеседование': '🗣',\n  'оформление': '📝',\n  'работает': '✅',\n  'отказ': '❌',\n  'архив': '📦'\n};\n\nconst message = `📋 *Изменить статус кандидата*\\n\\n` +\n  `👤 *${candidate.full_name}*\\n` +\n  `📞 ${candidate.phone || '-'}\\n` +\n  `💼 ${candidate.position || '-'}\\n` +\n  `📍 ${candidate.object_location || '-'}\\n\\n` +\n  `Текущий статус: ${statusEmoji[candidate.status] || '•'} *${candidate.status}*\\n\\n` +\n  `Выберите новый статус:`;\n\nreturn {\n  json: {\n    message,\n    keyboard,\n    chatId: parseData.chatId,\n    candidateId: candidate.id\n  }\n};"
      },
      "id": "build-status-buttons",
      "name": "Build Status Buttons",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
