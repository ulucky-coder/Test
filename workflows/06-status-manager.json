    {
      "parameters": {
        "jsCode": "// Build success message\nconst parseData = $('Parse Input').item.json;\nconst candidate = $('Search Candidate').item?.json || $('Get Candidate by ID').item?.json || {};\n\nconst statusEmoji = {\n  'направлен': '📋',\n  'собеседование': '🗣',\n  'оформление': '📝',\n  'работает': '✅',\n  'отказ': '❌',\n  'архив': '📦'\n};\n\nconst newStatus = parseData.newStatus;\nconst emoji = statusEmoji[newStatus] || '•';\n\nconst message = `✅ *Статус изменён*\\n\\n` +\n  `👤 *${candidate.full_name || 'Кандидат'}*\\n` +\n  `📊 Новый статус: ${emoji} *${newStatus}*\\n\\n` +\n  `_Изменено @${parseData.username}_`;\n\nreturn {\n  json: {\n    message,\n    chatId: parseData.chatId,\n    messageId: parseData.messageId\n  }\n};"
      },
