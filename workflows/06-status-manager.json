{
  "name": "HR Bot - Status Manager",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "status-manager",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "webhookId": "status-manager"
    },
    {
      "parameters": {
        "jsCode": "// Parse status command or callback\nconst input = $input.item.json;\n\nlet result = {\n  chatId: input.chatId,\n  userId: input.userId,\n  username: input.username,\n  messageId: input.messageId,\n  candidateId: null,\n  candidateSearch: null,\n  newStatus: null,\n  isCallback: false\n};\n\n// Callback from inline button: status_change_UUID или status_СТАТУС_UUID\nif (input.action === 'status') {\n  result.isCallback = true;\n  const parts = input.params.split('_');\n  \n  if (parts[0] === 'change') {\n    // status_change_UUID - показать кнопки выбора статуса\n    result.candidateId = parts[1];\n    result.showButtons = true;\n  } else {\n    // status_СТАТУС_UUID - изменить статус\n    result.newStatus = parts[0];\n    result.candidateId = parts[1];\n  }\n} else if (input.command === 'status' && input.args) {\n  // Command: /status Иванов собеседование\n  const args = input.args.trim();\n  const statuses = ['направлен', 'собеседование', 'оформление', 'работает', 'отказ', 'архив'];\n  \n  // Найти статус в конце строки\n  let foundStatus = null;\n  let searchTerm = args;\n  \n  for (const status of statuses) {\n    if (args.toLowerCase().endsWith(status)) {\n      foundStatus = status;\n      searchTerm = args.slice(0, -status.length).trim();\n      break;\n    }\n  }\n  \n  if (foundStatus) {\n    result.newStatus = foundStatus;\n    result.candidateSearch = searchTerm;\n  } else {\n    result.error = 'Укажите статус: направлен, собеседование, оформление, работает, отказ, архив';\n  }\n}\n\nreturn { json: result };"
      },
      "id": "parse-input",
      "name": "Parse Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
