        "query": "=SELECT change_candidate_status(\n  '{{ $json.id || $('Parse Input').item.json.candidateId }}'::uuid,\n  '{{ $('Parse Input').item.json.newStatus }}'::candidate_status,\n  {{ $('Parse Input').item.json.userId }},\n  '@{{ $('Parse Input').item.json.username }}',\n  NULL\n)"
      },
      "id": "change-status",
      "name": "Change Status",
      "type": "n8n-nodes-base.supabase",
